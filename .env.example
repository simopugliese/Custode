# Configurazione di Custode — SOLO placeholder, mai valori reali (§5, §9).
# Copia questo file in `.env` e riempilo sul Pi: `.env` è in .gitignore.
#
# Le variabili con prefisso CUSTODE_ sono lette da core/custode_core/config.py.

# — Base (servono già ora) —————————————————————————————

# development | test | production. In production l'API non pubblica /docs.
CUSTODE_AMBIENTE=development

# Percorso del file SQLite. Nei container è il volume montato su /data.
CUSTODE_DB_PATH=/data/custode.db

CUSTODE_LOG_LEVEL=INFO

# Fuso orario per digest mattutino, check-in e job schedulati (§8.13).
CUSTODE_TIMEZONE=Europe/Rome

# Origini ammesse a chiamare l'API dal browser: l'indirizzo della dashboard su
# Cloudflare Pages. Elenco separato da virgole. Vuoto = nessuna origine esterna.
CUSTODE_CORS_ORIGINS=https://custode.pages.dev

# — Bot Telegram (§8.1 e §9) ————————————————————————————

# Token del bot ottenuto da @BotFather. Senza, il servizio `bot` non parte.
TELEGRAM_BOT_TOKEN=

# Il tuo user ID Telegram numerico: unico mittente accettato, ogni altro
# messaggio viene ignorato senza risposta (whitelist di §9). Lo si ottiene
# scrivendo a @userinfobot. Vuoto o 0 = nessuno autorizzato, e il bot non parte:
# un default aperto sarebbe la peggiore configurazione possibile.
TELEGRAM_ALLOWED_USER_ID=

# Se registrare la lista dei comandi nel menu di Telegram (di norma sì).
# TELEGRAM_COMANDI_PUBBLICI=true

# — Router DeepSeek / Claude (§6) ————————————————————————
# Senza queste chiavi comandi e bottoni funzionano lo stesso: si perde solo il
# linguaggio libero, e il bot lo dice invece di fallire in silenzio.

# Chiave di DeepSeek: parsing lista spesa, CRUD task, classificazioni leggere.
ROUTER_DEEPSEEK_API_KEY=

# Chiave di Anthropic: riassunto del diario (§8.4), e più avanti scontrini,
# profilo e piani di ripasso (§6). **Serve** al diario: senza, il bot raccoglie
# comunque quello che racconti, ma /diario non può proporre il riassunto.
ROUTER_ANTHROPIC_API_KEY=

# Modelli e profondità di ragionamento (i default vanno bene).
# ROUTER_DEEPSEEK_MODELLO=deepseek-chat
# ROUTER_CLAUDE_MODELLO=claude-opus-5
# ROUTER_CLAUDE_EFFORT=high
# ROUTER_TIMEOUT_SECONDI=30
# Due tetti distinti: su claude-opus-5 il ragionamento adattivo consuma
# max_tokens, quindi quello di DeepSeek qui sarebbe troppo basso.
# ROUTER_MAX_TOKEN_RISPOSTA=1024
# ROUTER_MAX_TOKEN_RISPOSTA_CLAUDE=8000

# — Worker, job schedulati (§5, §8.4) ————————————————————
# Il worker manda i suoi messaggi su Telegram, quindi usa TELEGRAM_BOT_TOKEN e
# TELEGRAM_ALLOWED_USER_ID qui sopra: senza, si rifiuta di partire invece di
# girare in silenzio.

# Quando chiudere la settimana del diario: domenica | lunedi, e a che ora
# (HH:MM, nel fuso di CUSTODE_TIMEZONE). Se il Pi era spento a quell'ora il job
# parte appena torna su, non salta la settimana.
# WORKER_GIORNO_RIEPILOGO=domenica
# WORKER_ORA_RIEPILOGO=21:00

# Ogni quanto il worker si sveglia a chiedere "cosa è dovuto adesso?".
# WORKER_INTERVALLO_SECONDI=300

# — Whisper, trascrizione locale (§4, §13) ————————————————
# Dove il BOT va a cercare il servizio di trascrizione, sulla rete interna di
# Docker (prefisso TELEGRAM_ perché è una cosa che riguarda solo il bot).
# Vuoto = niente vocali, e il bot lo dice invece di restare in silenzio.
# TELEGRAM_WHISPER_URL=http://whisper:8100

# Queste le legge il servizio whisper, non il bot.
# Lingua forzata: `auto` su un vocale corto sbaglia e la trascrizione esce a caso.
# WHISPER_LINGUA=it
# Thread di whisper.cpp, tenuti bassi apposta perché una trascrizione lunga non
# rallenti bot e API (§13). Il Pi 5 ha 4 core.
# WHISPER_THREAD=2

# — Cloudflare Tunnel (fase 8, §2) ——————————————————————
# Token del tunnel creato nella dashboard Zero Trust.
# CLOUDFLARE_TUNNEL_TOKEN=
