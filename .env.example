# Configurazione di Custode — SOLO placeholder, mai valori reali (§5, §9).
# Copia questo file in `.env` e riempilo sul Pi: `.env` è in .gitignore.
#
# Le variabili con prefisso CUSTODE_ sono lette da core/custode_core/config.py.

# — Base (servono già ora) —————————————————————————————

# development | test | production. In production l'API non pubblica /docs.
CUSTODE_AMBIENTE=development

# Percorso del file SQLite. Nei container è il volume montato su /data.
CUSTODE_DB_PATH=/data/custode.db

CUSTODE_LOG_LEVEL=INFO

# Fuso orario per digest mattutino, check-in e job schedulati (§8.13).
CUSTODE_TIMEZONE=Europe/Rome

# Origini ammesse a chiamare l'API dal browser: l'indirizzo della dashboard su
# Cloudflare Pages. Elenco separato da virgole. Vuoto = nessuna origine esterna.
CUSTODE_CORS_ORIGINS=https://custode.pages.dev

# Quanto conti di spendere in una settimana, in euro (§8.5). Non ha un default:
# un budget deciso dal codice sarebbe un giudizio su come spendi. Finché resta
# vuoto la Home NON disegna il blocco «Spese · settimana» — una barra ha bisogno
# di un tetto — ma il totale speso resta visibile fra le statistiche in cima.
#
# Da §8 questo è il **valore di partenza**: appena salvi un budget dalla pagina
# Impostazioni vince quello, e questa riga smette di contare. Non è una seconda
# fonte di verità — è la configurazione con cui l'installazione nasce.
CUSTODE_BUDGET_SETTIMANALE=

# — Bot Telegram (§8.1 e §9) ————————————————————————————

# Token del bot ottenuto da @BotFather. Senza, il servizio `bot` non parte.
TELEGRAM_BOT_TOKEN=

# Il tuo user ID Telegram numerico: unico mittente accettato, ogni altro
# messaggio viene ignorato senza risposta (whitelist di §9). Lo si ottiene
# scrivendo a @userinfobot. Vuoto o 0 = nessuno autorizzato, e il bot non parte:
# un default aperto sarebbe la peggiore configurazione possibile.
TELEGRAM_ALLOWED_USER_ID=

# Se registrare la lista dei comandi nel menu di Telegram (di norma sì).
# TELEGRAM_COMANDI_PUBBLICI=true

# — Router DeepSeek / Claude (§6) ————————————————————————
# Senza queste chiavi comandi e bottoni funzionano lo stesso: si perde solo il
# linguaggio libero, e il bot lo dice invece di fallire in silenzio.

# Chiave di DeepSeek: parsing lista spesa, CRUD task, classificazioni leggere.
ROUTER_DEEPSEEK_API_KEY=

# Chiave di Anthropic: riassunto del diario (§8.4), e più avanti scontrini,
# profilo e piani di ripasso (§6). **Serve** al diario: senza, il bot raccoglie
# comunque quello che racconti, ma /diario non può proporre il riassunto.
ROUTER_ANTHROPIC_API_KEY=

# Modelli e profondità di ragionamento (i default vanno bene).
# ROUTER_DEEPSEEK_MODELLO=deepseek-chat
# ROUTER_CLAUDE_MODELLO=claude-opus-5
# ROUTER_CLAUDE_EFFORT=high
# ROUTER_TIMEOUT_SECONDI=30
# Due tetti distinti: su claude-opus-5 il ragionamento adattivo consuma
# max_tokens, quindi quello di DeepSeek qui sarebbe troppo basso.
# ROUTER_MAX_TOKEN_RISPOSTA=1024
# ROUTER_MAX_TOKEN_RISPOSTA_CLAUDE=8000

# — Worker, job schedulati (§5, §8.4) ————————————————————
# Il worker manda i suoi messaggi su Telegram, quindi usa TELEGRAM_BOT_TOKEN e
# TELEGRAM_ALLOWED_USER_ID qui sopra: senza, si rifiuta di partire invece di
# girare in silenzio.

# Quando chiudere la settimana del diario: domenica | lunedi, e a che ora
# (HH:MM, nel fuso di CUSTODE_TIMEZONE). Se il Pi era spento a quell'ora il job
# parte appena torna su, non salta la settimana.
#
# Come il budget, da §8 sono il **punto di partenza**: si cambiano dalla pagina
# Impostazioni, il worker li rilegge in cima a ogni giro, e un cambio è attivo
# entro cinque minuti senza riavviare il container.
# WORKER_GIORNO_RIEPILOGO=domenica
# WORKER_ORA_RIEPILOGO=21:00

# Ogni quanto il worker si sveglia a chiedere "cosa è dovuto adesso?".
# WORKER_INTERVALLO_SECONDI=300

# — Backup del database (§9) ————————————————————————————
# Il job gira ogni notte: copia coerente (non ferma niente), compressa, cifrata
# se gli dai una chiave, con retention 7 giornalieri + 4 settimanali.

# DOVE finiscono i backup sul Pi. Il default sta sulla stessa scheda del
# database: va bene per provare, non protegge dal guasto che conta. Puntalo al
# secondo disco (§13). È l'unica di queste che conviene impostare davvero.
CUSTODE_BACKUP_HOST=./backup

# Chiave Fernet. VUOTA = i backup NON sono cifrati (il worker te lo ripete ad
# ogni avvio, e l'estensione del file cambia). Generane una con:
#   docker compose run --rm worker python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CONSERVANE UNA COPIA FUORI DAL PI: un backup che non sai aprire non è un
# backup, e se perdi la chiave i file cifrati diventano rumore.
WORKER_BACKUP_CHIAVE=

# Ora locale del backup, e il percorso *dentro* il container (di norma stanno
# bene così: il collegamento col disco vero lo fa CUSTODE_BACKUP_HOST).
# WORKER_ORA_BACKUP=03:30
# WORKER_BACKUP_CARTELLA=/backup

# — Whisper, trascrizione locale (§4, §13) ————————————————
# Dove il BOT va a cercare il servizio di trascrizione, sulla rete interna di
# Docker (prefisso TELEGRAM_ perché è una cosa che riguarda solo il bot).
# Vuoto = niente vocali, e il bot lo dice invece di restare in silenzio.
# TELEGRAM_WHISPER_URL=http://whisper:8100

# Queste le legge il servizio whisper, non il bot.
# Lingua forzata: `auto` su un vocale corto sbaglia e la trascrizione esce a caso.
# WHISPER_LINGUA=it
# Thread di whisper.cpp, tenuti bassi apposta perché una trascrizione lunga non
# rallenti bot e API (§13). Il Pi 5 ha 4 core.
# WHISPER_THREAD=2
# Filtri ffmpeg applicati all'audio prima di trascrivere: via il rimbombo sotto
# gli 80 Hz, e parlato a volume costante dentro la registrazione. Un vocale
# registrato per strada è il caso normale. Svuotalo per confrontare col nudo.
# WHISPER_FILTRI_AUDIO=highpass=f=80,dynaudnorm
# `--suppress-nst`: su silenzio e rumore Whisper inventa, e in italiano tira
# fuori le frasi da sottotitoli, che poi arrivano all'interprete come se fossero
# state dette. (La VAD, che sarebbe il rimedio pulito, non c'è in v1.7.4.)
# WHISPER_SOPPRIMI_NON_PARLATO=true

# — Calendario, sola lettura (§8.10) ————————————————————
# Custode LEGGE e basta: il permesso chiesto è `calendar.readonly`, quindi una
# scrittura la rifiuterebbe Google, non solo il codice.
#
# Le credenziali si creano su console.cloud.google.com → API e servizi →
# Credenziali → ID client OAuth → tipo «Applicazione desktop». Nell'ID client
# va registrato l'URI di reindirizzamento http://localhost:8765
# CALENDARIO_CLIENT_ID=
# CALENDARIO_CLIENT_SECRET=
#
# Questo lo produce `custode-autorizza-calendario`, una volta sola (DEPLOY.md).
# ATTENZIONE: se la schermata di consenso resta in «Testing», Google fa scadere
# questo token dopo 7 GIORNI e il calendario smette di aggiornarsi in silenzio.
# Mettila «In production».
# CALENDARIO_REFRESH_TOKEN=
#
# Quale calendario leggere. «primary» è quello principale dell'account.
# CALENDARIO_CALENDARIO_ID=primary
# Quanta finestra tenere sincronizzata. Avanti bastano due settimane: le regole
# guardano al massimo qualche ora avanti. Indietro una: gli eventi si
# conservano, e con meno di così un Pi spento per qualche giorno lascerebbe in
# archivio un buco che non si richiude più.
# CALENDARIO_GIORNI_INDIETRO=7
# CALENDARIO_GIORNI_AVANTI=14
#
# Solo per il comando di autorizzazione: dove aspetta il clic di ritorno.
# `ascolta_su` va portato a 0.0.0.0 SOLO se lo lanci dentro un container, dove
# 127.0.0.1 è l'interno del container e il browser non lo raggiungerebbe.
# CALENDARIO_PORTA_AUTORIZZAZIONE=8765
# CALENDARIO_ASCOLTA_SU=127.0.0.1

# — Cloudflare Tunnel (fase 8, §2) ——————————————————————
# Token del tunnel creato nella dashboard Zero Trust.
# CLOUDFLARE_TUNNEL_TOKEN=
