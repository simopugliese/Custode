# Configurazione del listener del deploy (DEPLOY.md §6). Sul Pi diventa
# /etc/custode-deploy.env, con `chmod 600` e proprietario root. Non va nel repo
# con valori veri.

# Lo stesso valore del segreto GitHub DEPLOY_HMAC_SECRET. Generalo con
#     openssl rand -hex 32
CUSTODE_DEPLOY_SEGRETO=

# Dove ascolta. Deve essere l'indirizzo del Pi **dentro la rete di Compose**
# (il gateway di quella rete), così `cloudflared` lo raggiunge e la rete di casa
# no. Si trova con:
#     docker network inspect custode_default -f '{{(index .IPAM.Config 0).Gateway}}'
CUSTODE_DEPLOY_ASCOLTA=172.18.0.1:9000
